# Set MOCK=true to disable all external API calls.
MOCK=false

# Provider selection
# llm: groq | anthropic | nebius | minimax | ollama | mock
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3-32b

# Search backend: tavily | mock
SEARCH_BACKEND=tavily

# API keys (fill only what you use)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
NEBIUS_API_KEY=
MINIMAX_API_KEY=
TAVILY_API_KEY=

# Runtime controls
RESEARCH_MODE=true
ENABLE_RECOVERY=true
RECOVERY_MAX_ATTEMPTS=2
QUERY_REWRITE_VARIANTS=3
RERANK_TOP_K=4

# Parallelism and extraction
SEARCH_PARALLELISM=1
ADAPTIVE_PARALLELISM=true
EXTRACT_PARALLELISM=1
ENABLE_CLAIM_FILTER=true

# Early stopping / diminishing returns
DIMINISHING_WINDOW=4
MIN_COVERAGE_FOR_DIMINISHING=0.4

# Query compression
ENABLE_QUERY_COMPRESSOR=true
QUERY_COMPRESSOR_MODEL=llama-3.1-8b-instant

# Domain-policy threshold
MIN_DIRECT_DOMAIN_SCORE=0.3
